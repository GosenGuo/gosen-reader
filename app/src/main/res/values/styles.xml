<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#2F6B4F</item>
        <item name="android:navigationBarColor">#FAF8F2</item>
        <item name="android:statusBarColor">#FAF8F2</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <style name="AppTheme.Dark" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#6FD29E</item>
        <item name="android:navigationBarColor">#1B211E</item>
        <item name="android:statusBarColor">#101412</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">#101412</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
