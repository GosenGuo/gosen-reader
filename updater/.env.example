# MiniMax OpenAI-compatible text API. Use the domestic endpoint available
# in your MiniMax account when deploying in mainland China.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M2.5

# Free default: Bing RSS search, no search API key required.
SEARCH_PROVIDER=bing-rss

# Optional paid/custom search API. Set SEARCH_PROVIDER=api to use it.
SEARCH_API_KEY=
SEARCH_API_URL=https://api.bochaai.com/v1/web-search

# Batch settings
TARGET_ARTICLE_COUNT=30
MAX_SEARCH_RESULTS=80
OUTPUT_PATH=./dist/articles.json

# Optional publishing endpoint. GitHub Actions writes directly to docs/ and
# does not need these values.
PUBLISH_URL=
PUBLISH_BEARER=
